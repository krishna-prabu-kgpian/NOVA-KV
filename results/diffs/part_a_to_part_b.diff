diff --git a/src/cow_segment.cpp b/src/cow_segment.cpp
new file mode 100644
index 0000000..4cdb8e5
--- /dev/null
+++ b/src/cow_segment.cpp
@@ -0,0 +1,130 @@
+#include "cow_segment.h"
+
+#include "alloc.h"
+#include "test_points.h"
+
+#include <cstring>
+#include <new>
+
+namespace nova {
+
+void destroy_segment(Segment* seg) noexcept {
+    if (seg == nullptr) return;
+    NOVA_COUNT_OBJECT(LiveObject::Segment, -1);
+    free_bytes(seg->slots);
+    seg->~Segment();
+    free_bytes(seg);
+}
+
+SegmentBuilder::SegmentBuilder() noexcept
+    : work_(kCowInitialSegmentCapacity),
+      plan_(),
+      pins_(nullptr),
+      pin_count_(0),
+      pin_capacity_(0),
+      header_(nullptr),
+      changed_(false) {}
+
+SegmentBuilder::~SegmentBuilder() {
+    work_.abort_upsert(plan_);
+    free_bytes(pins_);
+    free_bytes(header_);  // raw storage only: no Segment was constructed in it
+}
+
+bool SegmentBuilder::begin(const Segment* base, std::uint32_t max_ops) noexcept {
+    const std::uint32_t base_pins = base != nullptr ? base->pin_count : 0;
+    pin_capacity_ = base_pins + max_ops;
+    if (pin_capacity_ != 0) {
+        pins_ = static_cast<ChunkPin*>(alloc_bytes(sizeof(ChunkPin) * pin_capacity_));
+        if (pins_ == nullptr) return false;
+        if (base_pins != 0) std::memcpy(pins_, base->pins, sizeof(ChunkPin) * base_pins);
+    }
+    pin_count_ = base_pins;
+    if (base != nullptr &&
+        !work_.clone_from(base->slots, base->capacity, base->live, base->tombstones)) {
+        return false;
+    }
+    return true;
+}
+
+bool SegmentBuilder::prepare_put(long key, std::uint64_t h) noexcept {
+    return work_.prepare_upsert(key, h, plan_);
+}
+
+void SegmentBuilder::commit_put(long key, std::uint64_t h, const ValueRef& ref) noexcept {
+    ValueRef old{};
+    const bool replaced = work_.commit_upsert(key, h, ref, plan_, &old);
+    pin_add(ref);
+    if (replaced) pin_sub(old);
+    changed_ = true;
+}
+
+void SegmentBuilder::abort_put() noexcept { work_.abort_upsert(plan_); }
+
+bool SegmentBuilder::erase(long key, std::uint64_t h) noexcept {
+    ValueRef old{};
+    if (!work_.erase(key, h, &old)) return false;
+    pin_sub(old);
+    changed_ = true;
+    return true;
+}
+
+void SegmentBuilder::pin_add(const ValueRef& ref) noexcept {
+    if (ref.length == 0) return;  // empty values live in no chunk
+    std::uint32_t lo = 0, hi = pin_count_;
+    while (lo < hi) {
+        const std::uint32_t mid = lo + (hi - lo) / 2;
+        if (pins_[mid].chunk_id < ref.chunk_id) lo = mid + 1;
+        else hi = mid;
+    }
+    if (lo < pin_count_ && pins_[lo].chunk_id == ref.chunk_id) {
+        ++pins_[lo].refs;
+        return;
+    }
+    // Room is guaranteed: begin() reserved one slot per put.
+    std::memmove(pins_ + lo + 1, pins_ + lo, sizeof(ChunkPin) * (pin_count_ - lo));
+    pins_[lo] = ChunkPin{ref.chunk_id, 1};
+    ++pin_count_;
+}
+
+void SegmentBuilder::pin_sub(const ValueRef& ref) noexcept {
+    if (ref.length == 0) return;
+    std::uint32_t lo = 0, hi = pin_count_;
+    while (lo < hi) {
+        const std::uint32_t mid = lo + (hi - lo) / 2;
+        if (pins_[mid].chunk_id < ref.chunk_id) lo = mid + 1;
+        else hi = mid;
+    }
+    // Present by construction: every occupied entry is counted in the list.
+    --pins_[lo].refs;  // entries that reach zero are dropped in finish()
+}
+
+bool SegmentBuilder::prepare_finish() noexcept {
+    if (work_.live() == 0) return true;  // the partition becomes empty: no segment
+    std::uint32_t used = 0;
+    for (std::uint32_t i = 0; i < pin_count_; ++i) used += pins_[i].refs != 0 ? 1u : 0u;
+    header_ = static_cast<Segment*>(
+        alloc_bytes(sizeof(Segment) + sizeof(ChunkPin) * used, alignof(Segment)));
+    return header_ != nullptr;
+}
+
+Segment* SegmentBuilder::finish() noexcept {
+    if (work_.live() == 0) return nullptr;  // work_'s array is freed with the builder
+    Segment* seg = new (header_) Segment();
+    NOVA_COUNT_OBJECT(LiveObject::Segment, 1);
+    header_ = nullptr;
+    seg->owners.store(0, std::memory_order_relaxed);
+    seg->capacity = work_.capacity();
+    seg->live = work_.live();
+    seg->tombstones = work_.tombstones();
+    seg->pins = reinterpret_cast<ChunkPin*>(seg + 1);
+    std::uint32_t n = 0;
+    for (std::uint32_t i = 0; i < pin_count_; ++i) {
+        if (pins_[i].refs != 0) seg->pins[n++] = pins_[i];
+    }
+    seg->pin_count = n;
+    seg->slots = work_.release_slots();
+    return seg;
+}
+
+}  // namespace nova
diff --git a/src/cow_segment.h b/src/cow_segment.h
new file mode 100644
index 0000000..4b03d9c
--- /dev/null
+++ b/src/cow_segment.h
@@ -0,0 +1,123 @@
+// cow_segment.h -- immutable published index segments and their private builder
+// (Part B).
+//
+// A Segment is one partition of the primary index as seen by readers: an
+// open-addressed, linearly probed slot array that never changes after it has
+// been published. A write that touches a partition does not modify its
+// Segment; it builds a replacement with SegmentBuilder (a private copy that is
+// edited in place where no reader can see it) and the replacement becomes
+// visible only as part of a newly published Version.
+//
+// Ownership recorded in a Segment (blueprint 3.3, 3.4):
+//   owners  number of Versions whose directory points at this segment. Several
+//           versions share an unchanged segment.
+//   pins    the distinct chunk IDs referenced by the segment's occupied slots.
+//           The segment holds one arena pin per listed chunk for as long as it
+//           exists, which is what keeps value bytes alive for every version
+//           that can still reach them.
+#pragma once
+
+#include "config.h"
+#include "hash.h"
+#include "hash_segment.h"
+#include "value_ref.h"
+
+#include <atomic>
+#include <cstdint>
+
+namespace nova {
+
+// One distinct chunk referenced by a segment. `refs` (how many of the segment's
+// entries point into the chunk) lets a builder keep the set exact when entries
+// are replaced or erased; the arena is pinned once per ChunkPin, not per entry.
+struct ChunkPin {
+    std::uint32_t chunk_id;
+    std::uint32_t refs;
+};
+
+struct Segment {
+    std::atomic<std::uint32_t> owners;  // versions referencing this segment (writer/cleaner side)
+    std::uint32_t capacity;             // power of two, > 0
+    std::uint32_t live;
+    std::uint32_t tombstones;
+    std::uint32_t pin_count;
+    Entry* slots;                       // immutable once published
+    ChunkPin* pins;                     // sorted by chunk_id; stored after this header
+};
+
+// Lookup in a published (or any) segment. Same rule as Part A: stop at Empty,
+// skip Tombstone, match on the full key. `seg` may be null (empty partition).
+inline const Entry* segment_find(const Segment* seg, long key, std::uint64_t h) noexcept {
+    if (seg == nullptr) return nullptr;
+    const std::uint32_t mask = seg->capacity - 1;
+    std::uint32_t i = static_cast<std::uint32_t>(h >> kPartitionBits) & mask;
+    for (std::uint32_t n = 0; n < seg->capacity; ++n, i = (i + 1) & mask) {
+        const Entry& e = seg->slots[i];
+        if (e.state == SlotState::Empty) return nullptr;
+        if (e.state == SlotState::Occupied && e.key == key) return &e;
+    }
+    return nullptr;
+}
+
+// Frees a segment's memory. Its arena pins must already have been dropped (or
+// never taken). Null is allowed.
+void destroy_segment(Segment* seg) noexcept;
+
+// Builds the replacement for one partition, privately.
+//
+//   begin()                      private copy of the published segment
+//   prepare_put / commit_put     insert or overwrite (two phases so the value
+//                                can be appended to the arena in between)
+//   erase                        remove
+//   prepare_finish()             last fallible step
+//   finish()                     hands over the immutable Segment; cannot fail
+//
+// Everything a builder allocates is released by its destructor unless finish()
+// handed it over, so abandoning a commit at any point is just destroying the
+// builders. A builder takes no arena pin and touches no shared counter: all
+// ownership is acquired by the caller after the last fallible step.
+class SegmentBuilder {
+public:
+    SegmentBuilder() noexcept;
+    ~SegmentBuilder();
+    SegmentBuilder(const SegmentBuilder&) = delete;
+    SegmentBuilder& operator=(const SegmentBuilder&) = delete;
+
+    // `base` may be null. `max_ops` bounds the puts that will follow (each can
+    // introduce at most one new chunk). False on allocation failure.
+    bool begin(const Segment* base, std::uint32_t max_ops) noexcept;
+
+    bool prepare_put(long key, std::uint64_t h) noexcept;  // false: allocation failure
+    void commit_put(long key, std::uint64_t h, const ValueRef& ref) noexcept;
+    void abort_put() noexcept;
+
+    // True if the key was present and is now removed. Needs no memory.
+    bool erase(long key, std::uint64_t h) noexcept;
+
+    bool changed() const noexcept { return changed_; }
+
+    // Allocates the Segment header for the final contents. False on failure.
+    bool prepare_finish() noexcept;
+    // Returns the finished segment (owners == 0, no pins taken yet), or null if
+    // the partition ended up with no live key. Requires prepare_finish().
+    Segment* finish() noexcept;
+
+    // Slot bytes copied or rebuilt on behalf of this builder so far.
+    std::uint64_t bytes_built() const noexcept { return work_.bytes_built(); }
+    std::uint64_t growths() const noexcept { return work_.growths(); }
+    std::uint64_t rebuilds() const noexcept { return work_.rebuilds(); }
+
+private:
+    void pin_add(const ValueRef& ref) noexcept;
+    void pin_sub(const ValueRef& ref) noexcept;
+
+    HashSegment work_;          // the private, editable copy
+    HashSegment::UpsertPlan plan_;
+    ChunkPin* pins_;            // sorted by chunk_id; entries may drop to refs == 0
+    std::uint32_t pin_count_;
+    std::uint32_t pin_capacity_;
+    Segment* header_;           // allocated by prepare_finish()
+    bool changed_;
+};
+
+}  // namespace nova
diff --git a/src/epoch.cpp b/src/epoch.cpp
new file mode 100644
index 0000000..938a9b4
--- /dev/null
+++ b/src/epoch.cpp
@@ -0,0 +1,189 @@
+#include "epoch.h"
+
+#include <new>
+#include <utility>
+#include <vector>
+
+namespace nova {
+
+namespace {
+constexpr std::uint32_t kSlotsPerBlock = 32;
+}
+
+// A block of slots. Fully initialized before it is linked; once linked it is
+// never unlinked, moved or freed until the domain is destroyed.
+struct EpochDomain::SlotBlock {
+    ReaderSlot slots[kSlotsPerBlock];
+    std::atomic<SlotBlock*> next{nullptr};
+};
+
+// ---- Which domains are alive ------------------------------------------------------
+//
+// A thread caches the slot it was given per domain. When the thread exits it
+// must give those slots back, but a domain may have been destroyed in the
+// meantime. Domains therefore carry an ID that is never reused, and this
+// registry says which IDs are alive. Thread exit and domain destruction both
+// take its mutex, so a slot is either returned to a live domain or not touched
+// at all. None of this is on the read path. The registry is never destroyed
+// (threads may exit during process shutdown).
+namespace {
+
+struct LiveDomains {
+    std::mutex mutex;
+    std::vector<std::pair<std::uint64_t, EpochDomain*>> live;
+    std::atomic<std::uint64_t> next_id{1};  // 0 is "no domain"
+};
+
+LiveDomains& live_domains() {
+    static LiveDomains* instance = new LiveDomains();
+    return *instance;
+}
+
+}  // namespace
+
+// Every slot this thread holds, for all domains. Destroyed at thread exit.
+struct EpochThreadCache {
+    struct Entry {
+        std::uint64_t domain_id;
+        ReaderSlot* slot;
+    };
+    std::vector<Entry> entries;
+
+    ~EpochThreadCache() {
+        LiveDomains& reg = live_domains();
+        std::lock_guard<std::mutex> lock(reg.mutex);
+        for (const Entry& e : entries) {
+            for (const auto& d : reg.live) {
+                if (d.first == e.domain_id) {
+                    d.second->release_slot(e.slot);  // the domain still exists
+                    break;
+                }
+            }
+            // Otherwise the domain is gone and took its slots with it.
+        }
+    }
+};
+
+namespace {
+thread_local EpochThreadCache tl_cache;
+}
+
+EpochDomain::EpochDomain()
+    : id_(live_domains().next_id.fetch_add(1)), epoch_(0), first_(nullptr) {
+    first_ = new (std::nothrow) SlotBlock();
+    LiveDomains& reg = live_domains();
+    std::lock_guard<std::mutex> lock(reg.mutex);
+    reg.live.emplace_back(id_, this);
+}
+
+EpochDomain::~EpochDomain() {
+    {
+        // After this block no exiting thread can reach this domain's slots.
+        LiveDomains& reg = live_domains();
+        std::lock_guard<std::mutex> lock(reg.mutex);
+        for (std::size_t i = 0; i < reg.live.size(); ++i) {
+            if (reg.live[i].first == id_) {
+                reg.live[i] = reg.live.back();
+                reg.live.pop_back();
+                break;
+            }
+        }
+    }
+    for (SlotBlock* b = first_; b != nullptr;) {
+        SlotBlock* next = b->next.load(std::memory_order_relaxed);
+        delete b;
+        b = next;
+    }
+}
+
+ReaderSlot* EpochDomain::acquire_slot() {
+    std::lock_guard<std::mutex> lock(registration_mutex_);
+    SlotBlock* last = nullptr;
+    for (SlotBlock* b = first_; b != nullptr; b = b->next.load(std::memory_order_seq_cst)) {
+        for (ReaderSlot& s : b->slots) {
+            // Only registration (under this mutex) sets `owned`; a release
+            // clears it. A free slot is inactive, so the collector ignores it.
+            if (s.owned.load(std::memory_order_seq_cst) == 0) {
+                s.owned.store(1, std::memory_order_seq_cst);
+                registrations_.fetch_add(1, std::memory_order_relaxed);
+                return &s;
+            }
+        }
+        last = b;
+    }
+    // Every slot is taken: add a block. It is complete (all slots inactive)
+    // before the store below makes it reachable, and the slot handed out is in
+    // a block that is already linked when the caller first announces in it.
+    SlotBlock* block = new (std::nothrow) SlotBlock();
+    if (block == nullptr || last == nullptr) throw std::bad_alloc();
+    block->slots[0].owned.store(1, std::memory_order_relaxed);
+    last->next.store(block, std::memory_order_seq_cst);                               // [R1] link
+    registrations_.fetch_add(1, std::memory_order_relaxed);
+    return &block->slots[0];
+}
+
+void EpochDomain::release_slot(ReaderSlot* slot) noexcept {
+    slot->state.store(kEpochInactive, std::memory_order_seq_cst);
+    slot->owned.store(0, std::memory_order_seq_cst);
+}
+
+ReaderSlot* EpochDomain::thread_slot_slow() {
+    for (const EpochThreadCache::Entry& e : tl_cache.entries) {
+        if (e.domain_id == id_) {
+            tl_epoch_last = EpochTlsLast{id_, e.slot};
+            return e.slot;
+        }
+    }
+    tl_cache.entries.reserve(tl_cache.entries.size() + 1);  // may throw: nothing acquired yet
+    ReaderSlot* slot = acquire_slot();                       // may throw: nothing recorded yet
+    tl_cache.entries.push_back(EpochThreadCache::Entry{id_, slot});  // cannot throw now
+    tl_epoch_last = EpochTlsLast{id_, slot};
+    return slot;
+}
+
+bool EpochDomain::try_advance() noexcept {
+    advance_attempts_.fetch_add(1, std::memory_order_relaxed);
+    std::uint64_t e = epoch_.load(std::memory_order_seq_cst);                         // [C1]
+    NOVA_TEST_POINT(TestPoint::CleanerBeforeScan);
+    for (SlotBlock* b = first_; b != nullptr; b = b->next.load(std::memory_order_seq_cst)) {  // [C2]
+        for (ReaderSlot& s : b->slots) {
+            const std::uint64_t announced = s.state.load(std::memory_order_seq_cst);  // [C3]
+            NOVA_TEST_POINT(TestPoint::CleanerMidScan);
+            if (announced != kEpochInactive && announced != e) {
+                // A participant is still in an older epoch: no advance. Not a
+                // wait; the next pass tries again.
+                advance_blocked_.fetch_add(1, std::memory_order_relaxed);
+                return false;
+            }
+        }
+    }
+    NOVA_TEST_POINT(TestPoint::CleanerBeforeAdvance);
+    // Advance by exactly one, and only from the epoch that was scanned.
+    if (!epoch_.compare_exchange_strong(e, e + 1, std::memory_order_seq_cst)) return false;  // [C4]
+    advance_successes_.fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
+
+EpochStats EpochDomain::stats() const noexcept {
+    EpochStats s;
+    s.epoch = epoch_.load(std::memory_order_seq_cst);
+    s.advance_attempts = advance_attempts_.load(std::memory_order_relaxed);
+    s.advance_successes = advance_successes_.load(std::memory_order_relaxed);
+    s.advance_blocked = advance_blocked_.load(std::memory_order_relaxed);
+    s.registrations = registrations_.load(std::memory_order_relaxed);
+    for (SlotBlock* b = first_; b != nullptr; b = b->next.load(std::memory_order_seq_cst)) {
+        for (const ReaderSlot& slot : b->slots) {
+            ++s.slots_total;
+            if (slot.owned.load(std::memory_order_seq_cst) != 0) ++s.slots_owned;
+            const std::uint64_t st = slot.state.load(std::memory_order_seq_cst);
+            if (st != kEpochInactive) {
+                ++s.slots_active;
+                if (st < s.oldest_active_epoch) s.oldest_active_epoch = st;
+            }
+            s.validation_retries += slot.retries.load(std::memory_order_relaxed);
+        }
+    }
+    return s;
+}
+
+}  // namespace nova
diff --git a/src/epoch.h b/src/epoch.h
